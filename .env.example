# =====================================================================
# T9DYA MANAGER — Variables d'environnement
#
# 1. Copiez ce fichier à la racine du projet :
#        cp .env.example .env
# 2. Renseignez les valeurs de votre projet Supabase
#    (Dashboard Supabase → Project Settings → API)
#
# ⚠️  Seules des valeurs PUBLIQUES doivent figurer ici :
#     - l'URL du projet
#     - la clé "anon" (publishable key)
#     La sécurité est assurée par les politiques RLS côté base.
#
# ⛔  N'ajoutez JAMAIS la clé "service_role" dans ce fichier :
#     elle donnerait un accès administrateur complet à tous les visiteurs.
# =====================================================================

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique
